@* admin inline editor kaldırıldı (siteyi yayına alırken admin tamamen sökülmüş durumda) *@
@*
@if (false)
{
    <script>
    (() => {
        // ---- removed ----
        const body = document.body;
        const toast = document.getElementById('edit-toast');
        const toggle = document.getElementById('ab-edit-toggle');
        const STORAGE_KEY = 'creida-edit-on';

        // İlk yüklemede önceki tercihi geri yükle
        if (localStorage.getItem(STORAGE_KEY) === '1') {
            toggle.checked = true;
            body.classList.add('edit-on');
        }

        toggle.addEventListener('change', () => {
            if (toggle.checked) {
                body.classList.add('edit-on');
                localStorage.setItem(STORAGE_KEY, '1');
                showToast('Düzenleme modu açık — yazılara tıkla, değiştir.');
                wireEditables();
            } else {
                body.classList.remove('edit-on');
                localStorage.removeItem(STORAGE_KEY);
                document.querySelectorAll('[data-edit]').forEach(el => el.contentEditable = 'false');
                showToast('Düzenleme modu kapalı.');
            }
        });

        function showToast(msg, isErr) {
            toast.textContent = msg;
            toast.classList.toggle('err', !!isErr);
            toast.classList.add('show');
            clearTimeout(toast._timer);
            toast._timer = setTimeout(() => toast.classList.remove('show'), 2400);
        }

        function parseEdit(raw) {
            // Biçim: "collection.field" veya "collection.field#id"
            const hashIdx = raw.indexOf('#');
            const id = hashIdx >= 0 ? raw.slice(hashIdx + 1) : null;
            const core = hashIdx >= 0 ? raw.slice(0, hashIdx) : raw;
            const dotIdx = core.indexOf('.');
            if (dotIdx < 0) return null;
            return { collection: core.slice(0, dotIdx), field: core.slice(dotIdx + 1), id };
        }

        async function save(el) {
            const parsed = parseEdit(el.dataset.edit);
            if (!parsed) return;
            const value = el.innerText.replace(/ /g, ' ').trim();
            // İlk kaydını tut, değişmemişse network'e gitmeyelim
            if (el.dataset.lastValue === value) return;
            el.dataset.lastValue = value;
            try {
                const res = await fetch('/admin/api/inline', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ collection: parsed.collection, field: parsed.field, value, id: parsed.id })
                });
                if (!res.ok) {
                    const data = await res.json().catch(() => ({}));
                    showToast('Kaydedilemedi: ' + (data.error || res.status), true);
                    return;
                }
                showToast('✓ Kaydedildi');
            } catch (e) {
                showToast('Bağlantı hatası', true);
            }
        }

        function wireEditables() {
            document.querySelectorAll('[data-edit]').forEach(el => {
                if (el.dataset.wired === '1') {
                    el.contentEditable = 'true';
                    return;
                }
                el.dataset.wired = '1';
                el.contentEditable = 'true';
                el.dataset.lastValue = el.innerText.replace(/ /g, ' ').trim();

                // Linkleri tıklanamaz yap edit modda — yoksa düzenlerken siteye götürür
                if (el.tagName === 'A') {
                    el.addEventListener('click', (e) => { if (body.classList.contains('edit-on')) e.preventDefault(); });
                }
                el.addEventListener('blur', () => save(el));
                el.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey && el.tagName !== 'TEXTAREA') {
                        e.preventDefault();
                        el.blur();
                    }
                    if (e.key === 'Escape') {
                        // İptal — eski değere dön
                        el.innerText = el.dataset.lastValue || '';
                        el.blur();
                    }
                });
            });
        }

        // Mod kapalıyken bile dinleyicileri bağla; toggle açılınca contentEditable aç/kapa
        wireEditables();
    })();
    </script>
}
*@
</body>
</html>
