@using System.Globalization
@inject Creida.Services.SiteSettingsService SiteSettings
@inject Creida.Services.AppearanceService Appearance
@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var site = SiteSettings.Get();
    var appearance = Appearance.Get();
    var googleFontsUrl = appearance.GoogleFontsUrl();
}
<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content="@L["Hero.Tail"]" />
    <meta property="og:title" content="@(ViewData["Title"] ?? "Creida")" />
    <meta property="og:description" content="@L["Footer.Tagline"]" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://creida.co" />

    <title>@(ViewData["Title"] ?? "Creida")</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Jost — Futura'nın ücretsiz/açık kaynak alternatifi. Mac kullanıcıları zaten sistemdeki gerçek Futura'yı görür. *@
    <link href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @if (!string.IsNullOrEmpty(googleFontsUrl))
    {
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="@googleFontsUrl" />
    }
    <style>@Html.Raw(appearance.ToCssVariables())</style>

    @* JSON-LD Organization schema (her sayfada) *@
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Organization",
        "name": "Creida",
        "alternateName": "Creida Reklam Ajansı",
        "url": "https://creida.co",
        "logo": "https://creida.co/img/logo.png",
        "description": "Kreatif düşünce ile dijital performansı birleştiren bağımsız bir reklam ajansı.",
        "founder": [
            { "@@type": "Person", "name": "Erdem Ulugerçek", "jobTitle": "Kurucu Ortak · Strateji" },
            { "@@type": "Person", "name": "Giray Can Muştu", "jobTitle": "Kurucu Ortak · Büyüme" },
            { "@@type": "Person", "name": "Begüm Yaşlı", "jobTitle": "Creative Director" }
        ],
        "address": { "@@type": "PostalAddress", "addressLocality": "Kadıköy", "addressRegion": "İstanbul", "addressCountry": "TR" },
        "email": "hello@creida.co",
        "telephone": "+90 531 405 30 70",
        "sameAs": ["https://instagram.com/creidaco", "https://linkedin.com/company/creidaco"]
    }
    </script>

    @* Plausible Analytics (opsiyonel — appsettings.json'da Analytics:PlausibleDomain doldurulursa aktif) *@
    @{
        var plausibleDomain = AppConfig["Analytics:PlausibleDomain"];
    }
    @if (!string.IsNullOrEmpty(plausibleDomain))
    {
        <script defer data-domain="@plausibleDomain" src="https://plausible.io/js/script.js"></script>
    }

    @* FOUC önleyici: CSS henüz uygulanmadan tema seçimini html'e yaz *@
    <script>
        (function () {
            try {
                var saved = localStorage.getItem('creida-theme');
                document.documentElement.setAttribute('data-theme', saved || 'dark');
            } catch (e) {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
</head>
<body>
    <a class="skip-link" href="#main">@(currentCulture == "en" ? "Skip to content" : "İçeriğe atla")</a>

    <header class="site-header" id="site-header">
