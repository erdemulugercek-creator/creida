                    <ul>
                        <li><a href="/sectors">Tüm sektörler</a></li>
                        <li><a href="/sectors/fintech">Fintech için</a></li>
                        <li><a href="/sectors/dtc">DTC için</a></li>
                        <li><a href="/sectors/b2b-saas">B2B SaaS için</a></li>
                    </ul>
                </div>
                <div class="mobile-nav-section">
                    <h5>Şeffaflık</h5>
                    <ul>
                        <li><a href="/pricing">Fiyatlandırma</a></li>
                        <li><a href="/results">Canlı sonuçlar</a></li>
                        <li><a href="/availability">Müsaitlik</a></li>
                        <li><a href="/report">Yıllık rapor</a></li>
                    </ul>
                </div>
                <div class="mobile-nav-section">
                    <h5>Hakkımızda</h5>
                    <ul>
                        <li><a href="/process">Çalışma şeklimiz</a></li>
                        <li><a href="/manifesto">Yapmadıklarımız</a></li>
                        <li><a href="/insights">Insights</a></li>
                    </ul>
                </div>
                <div class="mobile-nav-section">
                    <h5>Araçlar</h5>
                    <ul>
                        <li><a href="/brief">Brief Sihirbazı</a></li>
                        <li><a href="/resources">Kaynaklar</a></li>
                        <li><a href="/press">Basın</a></li>
                        <li><a href="/careers">Kariyer</a></li>
                        <li><a href="/#contact">İletişim</a></li>
                    </ul>
                </div>
            </div>

            <div class="header-right">
                <a class="cta-button cta-button--small" href="/#contact">
                    <span>@L["Nav.SendBrief"]</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </a>

                <button class="theme-toggle" type="button" aria-label="@(currentCulture == "en" ? "Toggle theme" : "Temayı değiştir")">
                    <svg class="icon-moon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" fill="currentColor" />
                    </svg>
                    <svg class="icon-sun" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" fill="currentColor" />
                        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                            <line x1="12" y1="2" x2="12" y2="5" />
                            <line x1="12" y1="19" x2="12" y2="22" />
                            <line x1="2" y1="12" x2="5" y2="12" />
                            <line x1="19" y1="12" x2="22" y2="12" />
                            <line x1="4.9" y1="4.9" x2="7" y2="7" />
                            <line x1="17" y1="17" x2="19.1" y2="19.1" />
                            <line x1="4.9" y1="19.1" x2="7" y2="17" />
                            <line x1="17" y1="7" x2="19.1" y2="4.9" />
                        </g>
                    </svg>
                </button>

                <button class="menu-toggle" aria-label="Menu" aria-expanded="false" type="button">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </header>

    <main id="main">
        @RenderBody()
    </main>

@* Footer geçici olarak kapatıldı — ileride geri açmak için bu if'i kaldır *@
