                    <li><a href="/brief">Brief Sihirbazı</a></li>
                    <li><a href="/pricing">Fiyatlandırma</a></li>
                    <li><a href="/availability">Müsaitlik</a></li>
                    <li><a href="/sectors">Sektörler</a></li>
